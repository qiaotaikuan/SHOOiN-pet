{
  "name": "aesthetic-frog-pet",
  "version": "3.6.0",
  "description": "桌面陪伴伙伴-小澍SHOOiN（番茄钟 / 待办 / 喝水久坐提醒）",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.aesthetic.frog.pet",
    "productName": "桌面陪伴伙伴-小澍SHOOiN",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "桌面陪伴伙伴-小澍SHOOiN"
    }
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  }
}
